<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width,initial-scale=1"/>
<title>TryOn &amp; Shop</title>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;700&family=Poppins:wght@400;600;700&display=swap"/>
{import.meta.env.DEV && <link rel="stylesheet" href="/virtual:stylex.css" />}
{import.meta.env.PROD && <link rel="stylesheet" href="/assets/stylex.css" />}
</head>
<body data-page="landing">
<header class="topbar"><a class="brand" href="/">TryOn &amp; Shop</a><a class="studio-link" href="/studio?owner=1">Studio</a></header>
<main class="landing">
  <div class="glow" aria-hidden="true"></div>
  <p class="eyebrow">AI virtual try-on · no app needed</p>
  <h1 class="hero-title">TryOn and Shop</h1>
  <p class="hero-sub">Try it on virtually, or inquire on WhatsApp.</p>
  <form class="search" id="search-form"><input class="search-input" id="q" name="q" type="search" placeholder="Search products…"/></form>
  <div class="pillrow" id="pills"></div>
  <p class="count" id="count"></p>
</main>
<main class="grid" id="grid"></main>
<script>
  import { landing } from "../lib/pages/landing";
  import { skin } from "../lib/skin";
  landing().finally(() => skin());
</script>
</body>
</html>
