# Whitelist: ignore everything, re-allow only tracked paths.
*
!.gitignore
!AGENTS.md
!Cargo.toml
!Cargo.lock
!wrangler.toml
!docs/
!docs/**
!design/
!design/**
!scripts/
!scripts/**
!client/
!client/**
!worker/
!worker/**
!shared/
!shared/**
!frontend/
!frontend/**
frontend/node_modules/
frontend/node_modules/**
frontend/dist/
frontend/dist/**
!imgpipe/
!imgpipe/**
!.github/
!.github/**
!.opencode/
!.opencode/**
!mock-genlook/
!mock-genlook/**

# astro generated
frontend/dist-astro/
frontend/dist-astro/**
frontend/.astro/
frontend/.astro/**
# local generated wasm glue copies
frontend/public/imgpipe/
frontend/public/imgpipe/**
frontend/imgpipe/
frontend/imgpipe/**

# vendored ionic camera UI (rebuilt by build.ts)
frontend/pwa/
frontend/pwa/**
